# Copy to backend/.env and replace the database placeholders with your Neon URL.
# Never put these settings in frontend VITE_* variables.
DATABASE_URL=postgresql://APP_ROLE:REPLACE_ME@HOST-pooler.neon.tech/DB_NAME?sslmode=require
# Optional direct URL for migration commands; use the same branch and database.
# Use the schema owner here, not the limited application role. Omit when unused.
# DATABASE_DIRECT_URL=postgresql://MIGRATION_OWNER:REPLACE_ME@HOST.neon.tech/DB_NAME?sslmode=require
DATABASE_POOL_MAX_SIZE=4
# Pool acquisition, individual connection attempts and each SQL statement (seconds).
DATABASE_TIMEOUT_SECONDS=5

# Relative paths resolve from backend/. Startup creates a private per-run child.
TEMP_IMAGE_DIR=.runtime/images
MAX_UPLOAD_BYTES=10000000
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_SIDE=10000
PREVIEW_MAX_EDGE=1600
IMAGE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
JPEG_QUALITY=92

# JSON array; empty for the planned same-origin development proxy.
# Example: ["http://localhost:5173","http://127.0.0.1:5173"]
# Set exact frontend origins for cross-origin browser access; restart the backend.
ALLOWED_ORIGINS=[]
